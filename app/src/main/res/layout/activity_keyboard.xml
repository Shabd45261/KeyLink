<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Invisible Trackpad Area (Background) -->
    <View
        android:id="@+id/trackpadView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.keylink.KeyboardLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:splitMotionEvents="true">

        <!-- ROW 0: F-KEYS -->
        <Button android:text="Esc" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F1" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F2" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F3" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F4" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F5" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F6" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F7" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F8" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F9" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F10" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F11" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F12" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="PrtSc" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="Ins" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>
        <Button android:text="Del" style="@style/KeyStyle" app:layout_rowIndex="0" app:layout_widthMultiplier="1.0"/>

        <!-- ROW 1: NUMBERS -->
        <Button android:text="~" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="1" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="2" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="3" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="4" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="5" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="6" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="7" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="8" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="9" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="0" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="-" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="=" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.0"/>
        <Button android:text="Backspace" style="@style/KeyStyle" app:layout_rowIndex="1" app:layout_widthMultiplier="1.85"/>

        <!-- ROW 2: QWERTY -->
        <Button android:text="Tab" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.55"/>
        <Button android:text="Q" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="W" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="E" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="R" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="T" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="Y" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="U" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="I" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="O" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="P" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="[" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="]" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.0"/>
        <Button android:text="\\" style="@style/KeyStyle" app:layout_rowIndex="2" app:layout_widthMultiplier="1.5"/>

        <!-- ROW 3: ASDF -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_rowIndex="3"
            app:layout_widthMultiplier="1.85">
            <Button android:id="@+id/key_caps" android:text="Caps" style="@style/KeyStyle" android:layout_width="match_parent" android:layout_height="match_parent"/>
            <View
                android:id="@+id/caps_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="#00FF00"
                android:visibility="gone"/>
        </FrameLayout>
        <Button android:text="A" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="S" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="D" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="F" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="G" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="H" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="J" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="K" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="L" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text=";" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="'" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.0"/>
        <Button android:text="Enter" style="@style/KeyStyle" app:layout_rowIndex="3" app:layout_widthMultiplier="1.9"/>

        <!-- ROW 4: ZXCV -->
        <Button android:text="Shift" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.95"/>
        <Button android:text="Z" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="X" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="C" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="V" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="B" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="N" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="M" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="," style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="." style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="/" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="Shift" style="@style/KeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>
        <Button android:text="↑" style="@style/NavKeyStyle" app:layout_rowIndex="4" app:layout_widthMultiplier="1.0"/>

        <!-- ROW 5: BOTTOM -->
        <Button android:text="Ctrl" style="@style/KeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="1.2"/>
        <Button android:text="Fn" style="@style/KeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="1.15"/>
        <Button android:text="Win" style="@style/KeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="1.2"/>
        <Button android:text="Alt" style="@style/KeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="1.2"/>
        <Button android:text=" " style="@style/KeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="4.9"/>
        <Button android:text="Alt" style="@style/KeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="1.2"/>
        <Button android:text="Ctrl" style="@style/KeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="1.2"/>
        <Button android:text="←" style="@style/NavKeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="1.0"/>
        <Button android:text="↓" style="@style/NavKeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="1.0"/>
        <Button android:text="→" style="@style/NavKeyStyle" app:layout_rowIndex="5" app:layout_widthMultiplier="1.0"/>

    </com.example.keylink.KeyboardLayout>

    <!-- Trackpoint overlaid near center -->
    <View
        android:id="@+id/trackpoint"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/trackpoint_bg"
        android:layout_gravity="center"
        android:layout_marginTop="-10dp"
        android:elevation="10dp" />

    <!-- Circular buttons as separate overlays -->
    <ImageButton
        android:id="@+id/btnSwitchTrackpad"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="bottom|left"
        android:layout_margin="12dp"
        android:background="@android:color/transparent"
        app:srcCompat="@drawable/mouse_icon"
        android:scaleType="fitCenter"
        android:elevation="15dp"
        android:contentDescription="Switch to Trackpad"/>

    <ImageButton
        android:id="@+id/btnSwitchGamepad"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="bottom|right"
        android:layout_margin="12dp"
        android:background="@android:color/transparent"
        app:srcCompat="@drawable/ic_gamepad_profile"
        android:scaleType="fitCenter"
        android:elevation="15dp"
        android:contentDescription="Switch to Gamepad"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#44000000"
        android:padding="5dp">
        <View
            android:id="@+id/connectionStatusDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#FF5252"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disconnected"
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>
    </LinearLayout>

</FrameLayout>
